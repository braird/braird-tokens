      "input":  { "$value": "#F5F4ED", "$type": "color", "$description": "input background" },
      "subtle": { "$value": "#E3E4DA", "$type": "color", "$description": "inactive chips, shimmer" },
      "warm":       { "$value": "#F0ECE8", "$type": "color", "$description": "dark-mode primary text (warm paper)" },
      "warm-muted": { "$value": "#B5ADA6", "$type": "color", "$description": "dark-mode muted text" }
    },
    "ink": {
      "forest":      { "$value": "#1B241F", "$type": "color", "$description": "forest ink — body copy/headings" },
      "forest-deep": { "$value": "#15281C", "$type": "color", "$description": "deepest forest — dark-mode ground" },
      "slate":       { "$value": "#586056", "$type": "color", "$description": "secondary text" },
      "mist":        { "$value": "#7B847A", "$type": "color", "$description": "muted text" }
