      "forest": { "$value": "#154029", "$type": "color", "$description": "hover/pressed — deep forest" },
      "text":   { "$value": "#1E6B40", "$type": "color", "$description": "AA-safe green for text on tints" }
    },
    "line": {
      "hair":   { "$value": "#DBDCD1", "$type": "color", "$description": "card borders, dividers" },
      "strong": { "$value": "#B6BAAB", "$type": "color", "$description": "input borders, viewfinder" }
    }
