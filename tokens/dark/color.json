      "bg": {
        "primary":   { "$value": "{primitive.ink.forest-deep}", "$type": "color", "$description": "PROVISIONAL" },
        "input":     { "$value": "{primitive.ink.forest}",      "$type": "color", "$description": "PROVISIONAL" },
        "card":      { "$value": "{primitive.ink.forest}",      "$type": "color", "$description": "PROVISIONAL" },
        "subtle":    { "$value": "{primitive.ink.forest}",      "$type": "color", "$description": "PROVISIONAL" },
        "overlay":   { "$value": "rgba(5, 10, 6, 0.55)",        "$type": "color", "$description": "PROVISIONAL" },
        "marketing": { "$value": "{primitive.ink.forest-deep}", "$type": "color", "$description": "PROVISIONAL" }
      },
      "text": {
        "primary":   { "$value": "{primitive.paper.warm}",       "$type": "color", "$description": "PROVISIONAL" },
        "secondary": { "$value": "{primitive.paper.warm-muted}", "$type": "color", "$description": "PROVISIONAL" },
        "muted":     { "$value": "{primitive.paper.warm-muted}", "$type": "color", "$description": "PROVISIONAL" }
